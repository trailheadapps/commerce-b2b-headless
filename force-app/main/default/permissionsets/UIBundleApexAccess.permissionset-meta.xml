<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>UIBundle Apex Access</label>
    <description>Grants access to all UIBundle Apex REST classes for Experience Cloud community users.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>UIBundleAuthUtils</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleChangePassword</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleForgotPassword</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleLogin</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleLogout</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleRegistration</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
